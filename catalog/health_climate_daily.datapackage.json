{
  "name": "health_climate_daily",
  "title": "Saúde e clima diários por município — Rondônia (MVP)",
  "version": "0.1.0",
  "description": "Grão município x dia. Versão v0.1.0 é sintética (ver campo climasus_meta.user.synthetic embutido no Parquet); v1.0.0 será gerada por pipelines/R/01_ro_gold.R a partir de SIM-DO + INMET reais.",
  "licenses": [{ "name": "CC-BY-4.0", "path": "https://creativecommons.org/licenses/by/4.0/" }],
  "sources": [
    { "title": "DATASUS SIM-DO", "path": "https://datasus.saude.gov.br" },
    { "title": "INMET", "path": "https://portal.inmet.gov.br" }
  ],
  "resources": [
    {
      "name": "health_climate_daily",
      "path": "gold/health_climate_daily/v0.1.0/uf=RO/data.parquet",
      "format": "parquet",
      "schema": {
        "fields": [
          { "name": "code_muni", "type": "integer", "description": "Código IBGE do município (7 dígitos)" },
          { "name": "name_muni", "type": "string", "description": "Nome do município" },
          { "name": "date", "type": "date", "description": "Dia" },
          { "name": "deaths_total", "type": "integer", "description": "Óbitos totais (grupos CID climate-sensitive)" },
          { "name": "deaths_resp", "type": "integer", "description": "Óbitos, grupo respiratório" },
          { "name": "deaths_circ", "type": "integer", "description": "Óbitos, grupo circulatório" },
          { "name": "tmean", "type": "number", "unit": "°C" },
          { "name": "tmax", "type": "number", "unit": "°C" },
          { "name": "tmin", "type": "number", "unit": "°C" },
          { "name": "precip", "type": "number", "unit": "mm" },
          { "name": "rh", "type": "number", "unit": "%" }
        ],
        "primaryKey": ["code_muni", "date"]
      }
    }
  ]
}
